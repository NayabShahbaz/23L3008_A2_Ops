# Copy to .env and fill in. .env is git-ignored and docker-ignored.

# ---------- DagsHub / MLflow (Task 3.2) ----------
DAGSHUB_USER=your-dagshub-username
DAGSHUB_REPO=23L3008_A2_Ops
MLFLOW_TRACKING_URI=https://dagshub.com/your-dagshub-username/23L3008_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=your-dagshub-username
MLFLOW_TRACKING_PASSWORD=your-dagshub-access-token
MLFLOW_EXPERIMENT_NAME=23L3008_A2_Ops

# ---------- Flask app (Task 4.4) ----------
FLASK_SECRET_KEY=change-me
FLASK_DEBUG=0
MODEL_PATH=models/champion.keras
MODEL_NAME=visionguard
MODEL_VERSION=champion
IMG_SIZE=224
DECISION_THRESHOLD=0.5
MAX_UPLOAD_MB=5
# local = load the model in-process; remote = call the cloud model API (Task 8)
# MODEL_API_KEY must equal the API_KEY set on the cloud host
INFERENCE_BACKEND=local
MODEL_API_URL=https://api-23l3008-a2-ops.onrender.com/predict
MODEL_API_TIMEOUT=90
MODEL_API_KEY=change-me-long-random-string

# ---------- Database (Task 5 / 6.3) ----------
# Local dev without Docker:  sqlite:///visionguard.db
# Inside Compose:            postgresql+psycopg2://visionguard:<pw>@db:5432/visionguard
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=visionguard
DATABASE_URL=sqlite:///visionguard.db

# ---------- Model API (Task 7) ----------
API_KEY=change-me-long-random-string
